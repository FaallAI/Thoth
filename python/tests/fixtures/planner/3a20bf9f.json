 "phrases": [
  {
   "id": "P1",
   "beat": "main",
   "text": "Rocky Gerung jadi sasaran eksperimen sosial.",
   "start": 0.0,
   "end": 2.508
  },
  {
   "id": "P2",
   "beat": "main",
   "text": "Ada yang minta dia konsisten,",
   "start": 2.589,
   "end": 4.098
  },
  {
   "id": "P3",
   "beat": "main",
   "text": "tapi ada juga yang justru menyebutnya sebagai",
   "start": 4.342,
   "end": 6.362
  },
  {
   "id": "P4",
   "beat": "main",
   "text": "penjilat nasional.",
   "start": 6.409,
   "end": 7.709
  },
  {
   "id": "P5",
   "beat": "evidence",
   "text": "Video ini ingin melihat bagaimana reaksi",
   "start": 0.0,
   "end": 1.892
  },
  {
   "id": "P6",
   "beat": "evidence",
   "text": "masyarakat saat bertemu langsung dengan",
   "start": 1.95,
   "end": 4.226
  },
  {
   "id": "P7",
   "beat": "evidence",
   "text": "Rocky Gerung di area CFD.",
   "start": 4.284,
   "end": 6.502
  },
  {
   "id": "P8",
   "beat": "reactions",
   "text": "Netizen pun bereaksi. Ada yang menyuruh tobat,",
   "start": 0.0,
   "end": 1.95
  },
  {
   "id": "P9",
   "beat": "reactions",
   "text": "ada yang mengira Rocky benci Jokowi karena tak diberi jabatan,",
   "start": 1.974,
   "end": 4.934
  },
  {
   "id": "P10",
   "beat": "reactions",
   "text": "sampai ada yang suka semua orang di video ini.",
   "start": 5.108,
   "end": 8.034
  },
  {
   "id": "P11",
   "beat": "footage",
   "text": "Momen ini menunjukkan betapa beragamnya pandangan",
   "start": 0.0,
   "end": 2.264
  },
  {
   "id": "P12",
   "beat": "footage",
   "text": "publik terhadap sosok Rocky Gerung.",
   "start": 2.322,
   "end": 4.365
  }
