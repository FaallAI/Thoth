 "phrases": [
  {
   "id": "P1",
   "beat": "main",
   "text": "Gibran Rakabuming Raka akhirnya buka suara",
   "start": 0.0,
   "end": 2.206
  },
  {
   "id": "P2",
   "beat": "main",
   "text": "soal isu pengunduran dirinya.",
   "start": 2.264,
   "end": 3.727
  },
  {
   "id": "P3",
   "beat": "main",
   "text": "Dia bilang menghormati semua kritik dan saran masyarakat.",
   "start": 3.971,
   "end": 7.152
  },
  {
   "id": "P4",
   "beat": "main",
   "text": "Gibran nggak mau dinamika ini jadi polemik",
   "start": 7.361,
   "end": 9.532
  },
  {
   "id": "P5",
   "beat": "main",
   "text": "politik yang panjang.",
   "start": 9.567,
   "end": 10.693
  },
  {
   "id": "P6",
   "beat": "main",
   "text": "Dia juga cerita baru saja bertemu Presiden Prabowo",
   "start": 10.937,
   "end": 13.282
  },
  {
   "id": "P7",
   "beat": "main",
   "text": "yang sudah dianggap seperti ayahnya sendiri.",
   "start": 13.363,
   "end": 15.65
  },
  {
   "id": "P8",
   "beat": "main",
   "text": "Saran dari Presiden adalah agar Gibran tetap",
   "start": 15.894,
   "end": 17.995
  },
  {
   "id": "P9",
   "beat": "main",
   "text": "berjuang di PTUN dengan membawa",
   "start": 18.042,
   "end": 20.027
  },
  {
   "id": "P10",
   "beat": "main",
   "text": "semua dokumen pendidikan dari SD",
   "start": 20.12,
   "end": 22.082
  },
  {
   "id": "P11",
   "beat": "main",
   "text": "sampai S1.",
   "start": 22.291,
   "end": 23.638
  },
  {
   "id": "P12",
   "beat": "evidence",
   "text": "Kabar ini muncul setelah ada isu bahwa pihak",
   "start": 0.0,
   "end": 2.183
  },
  {
   "id": "P13",
   "beat": "evidence",
   "text": "istana sudah menyampaikan niatan",
   "start": 2.252,
   "end": 4.4
  },
  {
   "id": "P14",
   "beat": "evidence",
   "text": "pengunduran diri Gibran ke Presiden",
   "start": 4.47,
   "end": 6.444
  },
  {
   "id": "P15",
   "beat": "evidence",
   "text": "Prabowo Subianto.",
   "start": 6.502,
   "end": 7.941
  },
  {
   "id": "P16",
   "beat": "reactions",
   "text": "Netizen pun bereaksi.",
   "start": 0.0,
   "end": 0.987
  },
  {
   "id": "P17",
   "beat": "reactions",
   "text": "Ada yang bilang suaranya mirip banget sama bapaknya.",
   "start": 1.022,
   "end": 3.262
  },
  {
   "id": "P18",
   "beat": "reactions",
   "text": "Ada juga yang memohon agar Gibran jangan",
   "start": 3.471,
   "end": 5.422
  },
  {
   "id": "P19",
   "beat": "reactions",
   "text": "mengundurkan diri.",
   "start": 5.492,
   "end": 6.432
  },
  {
   "id": "P20",
   "beat": "reactions",
   "text": "Bahkan ada yang merasa arahnya Prabowo ingin",
   "start": 6.711,
   "end": 8.858
  },
  {
   "id": "P21",
   "beat": "reactions",
   "text": "menendang Gibran.",
   "start": 8.905,
   "end": 10.124
  },
  {
   "id": "P22",
