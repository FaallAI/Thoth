{
  "name": "scout",
  "private": true,
  "version": "1.0.0",
  "description": "Upstream content-sourcing untuk Thoth — TypeScript, dijalankan native via Bun (tanpa build step).",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:acquisition": "bun acquisition/run_all_tests.ts",
    "test:runtime": "bun test runtime/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  }
}
